ALPHA_VANTAGE_API_KEY=
MARKET_DATA_CACHE_TTL_MINUTES=30
NEXT_PUBLIC_APP_NAME=Capital Command
# Optional: connect the Finance & Billing dashboard to live Stripe data.
# Use a restricted (read-only) key. Without it, the dashboard shows sample data.
STRIPE_SECRET_KEY=

# Optional: connect the YouTube section to live channel data (subscribers,
# views, watch hours, per-video stats). Without it, the Studio view derives its
# numbers from the content you track in Capital Command.
YOUTUBE_API_KEY=

# Optional: Reply Studio / X strategy — generates daily search queries and
# account picks with Claude. Without it, those AI suggestions are skipped.
ANTHROPIC_API_KEY=
