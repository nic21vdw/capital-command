ALPHA_VANTAGE_API_KEY=
MARKET_DATA_CACHE_TTL_MINUTES=30
NEXT_PUBLIC_APP_NAME=Nic Vandewetering
# Optional: connect the Finance & Billing dashboard to live Stripe data.
# Use a restricted (read-only) key. Without it, the dashboard shows sample data.
STRIPE_SECRET_KEY=

# Optional: connect the YouTube section to live channel data (subscribers,
# views, watch hours, per-video stats). Without it, the Studio view derives its
# numbers from the content you track in Nic Vandewetering.
YOUTUBE_API_KEY=

# Optional: Reply Studio / X strategy — generates daily search queries and
# account picks with Claude. Without it, those AI suggestions are skipped.
ANTHROPIC_API_KEY=

# Optional: also save finished Clip Generator clips to your Google Drive — with
# no API keys and no sign-in. Install Google Drive for Desktop, then set this to
# a path INSIDE your synced Drive folder. Each job's clips are copied to
# "<this folder>\clipping agent\<stream title>\" and Drive syncs them to the
# cloud automatically. Leave blank to keep clips only under data\clips\outputs\.
# Example (Windows): CLIPS_DRIVE_DIR=G:\My Drive
# Example (macOS):   CLIPS_DRIVE_DIR=/Users/you/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive
CLIPS_DRIVE_DIR=

# Optional: where "backup-to-drive.bat" saves timestamped snapshots of your
# dashboard data (data\capital-command.json). Point this INSIDE your Google
# Drive for Desktop folder and Drive syncs each backup to the cloud — no API
# keys, no sign-in. If left blank, the backup falls back to CLIPS_DRIVE_DIR,
# and if that is also blank, snapshots are kept locally in the project's
# backups\ folder (not synced).
# Example (Windows): BACKUP_DRIVE_DIR=G:\My Drive
BACKUP_DRIVE_DIR=

# ---------------------------------------------------------------------------
# Scheduled clip publishing (YouTube Shorts / Instagram Reels / TikTok).
# Everything below is optional — leave it blank and the clipper behaves
# exactly as before. See README "Scheduled publishing" for full setup steps.
# NEVER commit real values; .env is gitignored.
# ---------------------------------------------------------------------------

# Master switch for the publisher (queue, runner, /api/publish routes).
PUBLISH_ENABLED=false
# Auto-enqueue every finished editor export (otherwise enqueue manually via
# the CLI or POST /api/publish with your chosen per-clip publish time).
PUBLISH_AUTO_ENQUEUE=false
# Minutes from export-finish to the auto-enqueued publish time.
PUBLISH_AUTO_ENQUEUE_DELAY_MINUTES=60
# Comma list; drop a platform to disable it. Default: all four.
PUBLISH_PLATFORMS=youtube,instagram,tiktok,facebook
# All publish times you type are interpreted in this timezone.
PUBLISH_TIMEZONE=America/Toronto
# public | private | unlisted. Start private for safe testing; note Instagram
# and Facebook only support public (neither API has drafts) and TikTok stays
# SELF_ONLY until TIKTOK_AUDITED=true regardless of this value.
PUBLISH_DEFAULT_VISIBILITY=private
# Where queue state lives: "file" (data/publish-queue.json, local-only) or
# "r2" (stored in the S3 bucket — REQUIRED for the GitHub Actions cron).
PUBLISH_QUEUE_BACKEND=file

# --- YouTube Data API v3 (native scheduled publishing via status.publishAt).
# Google Cloud Console → create OAuth client (Desktop app), enable
# "YouTube Data API v3", then mint a refresh token with scope
# https://www.googleapis.com/auth/youtube.upload (see README).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional numeric category, e.g. 20 (Gaming), 22 (People & Blogs).
YOUTUBE_CATEGORY_ID=

# --- Instagram Graph API content publishing (Reels).
# Needs an Instagram Business/Creator account linked to a Facebook Page and a
# Meta app with instagram_content_publish. IG_USER_ID is the numeric
# professional-account id, not the username.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Graph API version used for calls (bump when Meta retires old versions).
IG_GRAPH_API_VERSION=v23.0
# Webhooks (/api/instagram/webhook): arbitrary string you also paste into the
# Meta App Dashboard's webhook subscription "Verify Token" field.
IG_WEBHOOK_VERIFY_TOKEN=
# Meta app secret (App Dashboard -> Settings -> Basic). Verifies the
# X-Hub-Signature-256 header on incoming webhook events; leave blank to skip
# signature verification (not recommended in production).
IG_APP_SECRET=

# --- Facebook Graph API Video Reels publishing (Page).
# Needs a Facebook Page and a Page access token (not a user token) with
# pages_manage_posts. FB_PAGE_ID is the numeric Page id, not its username.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Graph API version used for calls (bump when Meta retires old versions).
FB_GRAPH_API_VERSION=v23.0

# --- TikTok Content Posting API (Direct Post).
# Unaudited apps can only post SELF_ONLY (visible just to you). After TikTok
# approves your app's audit, set TIKTOK_AUDITED=true to honor the configured
# visibility (public → PUBLIC_TO_EVERYONE).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_AUDITED=false
# "file" = direct binary upload (default, no hosting needed);
# "url" = PULL_FROM_URL from the hosting bucket (domain must be verified).
TIKTOK_UPLOAD_MODE=file

# Optional: Higgsfield Avatar — generate real-footage-style videos of your
# trained AI avatar from a scene prompt. Set up the avatar/auth once with the
# Higgsfield CLI (npm install -g @higgsfield/cli && higgsfield auth login),
# then paste an API key here. Without it, the Avatar page still works but new
# generations fail with a clear "not configured" message.
HIGGSFIELD_API_KEY=
# Optional: default avatar to render if a request doesn't specify one.
HIGGSFIELD_AVATAR_ID=

# Optional: Voiceover — synthesize typed dialogue in your cloned voice via
# ElevenLabs. Clone your voice at elevenlabs.io, then grab an API key and the
# resulting voice id. Without both, the Voiceover page still works but new
# generations fail with a clear "not configured" message.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Media hosting (S3-compatible; Cloudflare R2 free tier keeps this $0).
# Required for Instagram (it downloads the video from a public HTTPS URL) and
# for the GitHub Actions runner (queue + media must live off your PC).
# R2: dashboard → R2 → create bucket → "Manage R2 API tokens" for the keys.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Optional: public bucket/custom-domain base URL. Blank = presigned URLs.
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Podcast Studio (Spotify / Apple Podcasts / YouTube Music / Substack).
# Command generates MP3s locally. For real directory distribution, host
# Command at the public HTTPS URL below and configure R2 with a permanent
# S3_PUBLIC_BASE_URL so episode enclosures never expire.
# ---------------------------------------------------------------------------
PODCAST_PUBLIC_BASE_URL=
PODCAST_TITLE=Building CoLateral with Nic Vandewetering
PODCAST_DESCRIPTION=
PODCAST_AUTHOR=Nic Vandewetering
# Required for Apple Podcasts validation. Artwork must be a public HTTPS image.
PODCAST_ARTWORK_URL=
PODCAST_OWNER_EMAIL=
