{
  "name": "colateral-intro",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion intro cards: five CoLateral name reveals on the product's dark stage, with Beamy the pixel-art I-beam mascot.",
  "scripts": {
    "preview": "remotion studio",
    "render:all": "npm run render:drafting && npm run render:loadpath && npm run render:beamy && npm run render:canvas && npm run render:typeset",
    "render:drafting": "remotion render RevealDraftingTable out/colateral-drafting-table.mp4",
    "render:loadpath": "remotion render RevealLoadPath out/colateral-load-path.mp4",
    "render:beamy": "remotion render RevealBeamyEntrance out/colateral-beamy-entrance.mp4",
    "render:canvas": "remotion render RevealCanvasSpawn out/colateral-canvas-spawn.mp4",
    "render:typeset": "remotion render RevealTypeset out/colateral-typeset.mp4",
    "still": "remotion still RevealTypeset out/poster.png --frame=170"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
