{
  "name": "capital-command",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-dev-cache.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/prepare-dev-cache.mjs",
    "build": "next build",
    "postbuild": "node scripts/stamp-build-commit.mjs",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\run-tests.ps1",
    "format": "prettier --write .",
    "publish:dry": "tsx src/lib/publisher/cli.ts run-due --dry-run",
    "publish:run": "tsx src/lib/publisher/cli.ts run-due",
    "publish:scheduler": "tsx src/lib/publisher/cli.ts scheduler",
    "publish:register": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\register-publish-task.ps1",
    "tiktok:audit": "tsx src/lib/publisher/auditCheck.ts",
    "tiktok:watch:register": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\register-tiktok-audit-task.ps1",
    "publish:list": "tsx src/lib/publisher/cli.ts list",
    "publish:enqueue": "tsx src/lib/publisher/cli.ts enqueue",
    "publish:buffer": "tsx src/lib/publisher/cli.ts buffer sync",
    "publish:buffer:profiles": "tsx src/lib/publisher/cli.ts buffer profiles",
    "publish:instagram:connect": "tsx src/lib/publisher/cli.ts instagram connect",
    "publish:instagram:check": "tsx src/lib/publisher/cli.ts instagram check",
    "threads:register": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\register-threads-task.ps1",
    "threads:tick": "tsx src/lib/threads/cli.ts tick",
    "threads:dry": "tsx src/lib/threads/cli.ts tick --dry-run",
    "threads:plan": "tsx src/lib/threads/cli.ts plan",
    "threads:run": "tsx src/lib/threads/cli.ts run-due",
    "threads:status": "tsx src/lib/threads/cli.ts status",
    "threads:links": "node scripts/threads-links.mjs",
    "threads:check": "tsx src/lib/threads/cli.ts check",
    "ingest:scan": "tsx src/lib/ingest/cli.ts scan",
    "ingest:scan:all": "tsx src/lib/ingest/cli.ts scan --all",
    "ingest:dry": "tsx src/lib/ingest/cli.ts scan --dry-run",
    "ingest:ledger": "tsx src/lib/ingest/cli.ts ledger",
    "remotion:preview": "remotion studio",
    "remotion:render": "remotion render",
    "publish:mirror": "tsx src/lib/publisher/cli.ts mirror",
    "publish:retitle": "tsx src/lib/publisher/cli.ts retitle"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hookform/resolvers": "^5.0.1",
    "@huggingface/transformers": "^3.8.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@remotion/bundler": "^4.0.486",
    "@remotion/cli": "^4.0.486",
    "@remotion/google-fonts": "^4.0.486",
    "@remotion/player": "^4.0.486",
    "@remotion/renderer": "^4.0.486",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "remotion": "^4.0.486",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/eslint-plugin-next": "^15.5.15",
    "@tailwindcss/postcss": "^4.1.5",
    "@types/node": "^22.15.17",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
